# === LLM Provider ===
# Options: "gemini" or "openai"
LLM_PROVIDER=gemini

# Provide the API key for your chosen provider
GEMINI_API_KEY=
OPENAI_API_KEY=

# === Neo4j AuraDB (Cloud) ===
# Get your free instance at https://neo4j.com/cloud/platform/aura-graph-database/
# Example URI: neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-auradb-password

# === Vector Store (Qdrant) ===
# By default, runs locally in-process at data/qdrant_db (NO DOCKER NEEDED!)
# Optional: Set QDRANT_URL and QDRANT_API_KEY if using Qdrant Cloud
# QDRANT_URL=
# QDRANT_API_KEY=
